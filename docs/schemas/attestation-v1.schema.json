{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XLAxiom detached attestation v1",
  "type": "object",
  "required": ["attestation_version", "subject", "subject_sha256", "created_at_utc", "signature_algorithm", "signature_base64"],
  "properties": {
    "attestation_version": {"const": "1.0"},
    "subject": {"type": "string", "minLength": 1},
    "subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at_utc": {"type": "string"},
    "signature_algorithm": {"const": "openssl-dgst-sha256"},
    "signature_base64": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
